# 绝对不要同步的系统和工具目录
anaconda3/
cuda-12.1-toolkit/
*.tar.xz
*.zip
*.gz
# 屏蔽所有大型权重文件（.pt, .bin, .safetensors, .pth）
*.pt
*.bin
*.safetensors
*.pth
paligemma_base/

# 屏蔽数据文件（仿真产生的轨迹和 HDF5）
*.hdf5
*.pkl
data/
/data/*

# 屏蔽实验日志（这些会让 Git 历史变得臃肿）
logs/
*.log

# 屏蔽 Python 缓存
__pycache__/
*.pyc

# 屏蔽软连接指向的真实内容
# 如果你在项目里创建了指向 /data 的软连接，Git 通常只传链接
# 但为了保险，我们可以显式排除
mllama/
